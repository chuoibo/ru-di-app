# Separate codec worker; the API's distroless image stays unchanged.
ARG GO_IMAGE=golang:1.23.4-bookworm@sha256:95db116434e3f21a2a15600ffc7169bf380c6bfd021b154d106fcb346721c277
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
FROM ${GO_IMAGE} AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -ldflags="-s -w" -o /out/core ./cmd/core
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
 && mkdir -p /runtime/usr/bin \
 && cp /usr/bin/ffmpeg /usr/bin/ffprobe /runtime/usr/bin/ \
 && ldd /usr/bin/ffmpeg /usr/bin/ffprobe | awk '/=> \// {print $3} /\/.*ld-linux/ {print $1}' | sort -u | xargs -r cp -L --parents -t /runtime \
 && rm -rf /var/lib/apt/lists/*
FROM ${RUNTIME_IMAGE}
COPY --from=build /runtime/ /
COPY --from=build /out/core /core
USER 10001:10001
ENTRYPOINT ["/core"]
CMD ["community-media-worker"]
