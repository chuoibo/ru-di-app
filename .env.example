# Copy to .env and fill in. Never commit .env: repo guard blocks obvious
# secrets, but the reliable rule is that real credentials do not enter the
# working tree at all.

# Postgres. The default matches docker-compose.yml, which is development only:
# the password there is literally "mobile-dev-only" so nobody mistakes it for
# something that should reach a server.
MOBILE_DATABASE_URL=postgresql+psycopg://mobile:mobile-dev-only@localhost:5432/mobile

# Where the guest page links point. Must be reachable from a phone on mobile
# data, not just from this machine, or a guest opens a link that goes nowhere.
MOBILE_PUBLIC_BASE_URL=http://localhost:8000

# Gemini, for reading a bill photo. Absent means the AI path is disabled and
# the structured form still works; the product is designed to survive that
# (spec section 13.4 lets the whole image path be cut without losing v1).
#
# The name is GEMINI_API_KEY, with no MOBILE_ prefix, because that is what
# `services/api/app/api/vision_gemini.py` reads. This file used to say
# MOBILE_GEMINI_API_KEY -- a name nothing in the repo consumes, so anyone who
# followed the example exactly ended up with a key that looked set and was
# never read. `make up` warns when it is missing; it cannot warn about a key
# filed under the wrong name.
GEMINI_API_KEY=

# Nếp image and MP4 renderer. Both values are required to enable generation.
# The token is a credential; keep it outside every worktree and Git commit.
NEP_PROXY_URL=
NEP_PROXY_TOKEN=

# Shared secret between Go core and the Python brain (ADR-0029 §2.7). Empty
# refuses to start the API. Compose defaults to local-brain-token; generate a
# real one for any host that is not this machine:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MOBILE_INTERNAL_TOKEN=

# The key that stands between a person id and somebody's telephone number.
#
# `people.id` is HMAC-SHA256 of the number under this key. Before it existed
# the id was an unkeyed digest, and since Vietnamese mobile numbers are a space
# of about 5x10^8 anybody holding an id and a clone of this repository could
# enumerate that space and recover the number: measured at 257,316 candidates
# per second on one core, which is 30 seconds for a whole prefix. The key is
# the only thing that makes that arithmetic fail.
#
# GENERATE IT, do not invent it. A key somebody thought up is a key somebody
# can guess, and guessing it hands over every number at once:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# At least 32 characters or the API refuses to use it. With no key set,
# POST /identity/person-id answers 503 and nobody can sign in -- deliberately,
# because the alternative is falling back to the unkeyed digest and shipping
# the vulnerability to whoever skipped this line.
#
# Changing it changes every derived id, so everybody signs in to a new empty
# account. That is an account migration, not a config tweak.
#
# The name is MOBILE_PERSON_ID_KEY because that is what
# `services/api/app/api/person_identity.py` reads, and
# `tests/api/test_person_identity.py` fails if this file and that module ever
# disagree -- the mistake #89 shipped with the Gemini key above.
MOBILE_PERSON_ID_KEY=

# --- Đăng nhập OTP (ADR-0016) -------------------------------------------------
# Không đặt MOBILE_SMS_GATEWAY_URL thì máy chủ dùng LogSmsSender: không gửi gì,
# chỉ ghi log «đã phát challenge» (kèm mã khi MOBILE_OTP_LOG_CODES=1). Đó là
# host dev/emulator. Có URL thì phải có TOKEN; template dùng {code}.
MOBILE_SMS_GATEWAY_URL=
MOBILE_SMS_GATEWAY_TOKEN=
MOBILE_SMS_TEMPLATE=
MOBILE_OTP_LOG_CODES=
# Mã cố định để Maestro/seed đăng nhập xác định. CHỈ hợp lệ khi không có gateway;
# đặt cả hai thì máy chủ từ chối khởi động. Đúng 6 chữ số.
MOBILE_OTP_DEBUG_CODE=

# --- Đăng nhập Google (ADR-0016) ----------------------------------------------
# Các client id của app (Web + Android), phân cách bằng dấu phẩy. App lấy ID
# token qua @react-native-google-signin với webClientId; máy chủ kiểm chữ ký với
# Google và chỉ nhận token có audience nằm trong danh sách này. Trống thì
# POST /auth/google trả 503 google_not_configured — không có cửa Google trên
# host đó, và nó nói ra thay vì nhận bất kỳ token nào.
MOBILE_GOOGLE_CLIENT_IDS=

# --- Worker AI (engine chatassist, lát 4 của docs/architecture/03-ai-engine-hop-dong.md) ---
# Trống hoặc 1: `core serve` tự chạy worker AI (một process như trước). 0: worker
# chạy riêng bằng `core work`; `serve` vẫn chạy sweep giữ trần 15 phút plaintext.
MOBILE_INPROC_WORKER=
# Số job chạy cùng lúc mỗi process (1..64, mặc định 2) và độ dài lease (15..300
# giây, mặc định 75). Chỉ hạ lease khi MỌI process claim job đều có heartbeat.
MOBILE_AI_WORKERS=
MOBILE_AI_LEASE_SECONDS=
# Nếp trả lời bằng engine nào (ADR-0044, lát 6). Trống hoặc `brain`: não Python
# (`nep-reply`), như trước. `go`: engine Go (`internal/aiharness`) gọi Gemini
# thẳng từ process chạy worker AI, bằng GEMINI_API_KEY ở trên; process đó từ
# chối khởi động nếu thiếu khoá, base URL không phải loopback, hoặc chưa chạy
# `core migrate-chat` (bảng ai_turn_metrics). Chỉ đọc một lần lúc khởi động.
#
# Biến này chỉ có tác dụng khi chạy binary `core` trực tiếp. Compose KHÔNG đọc
# nó: `core` trong docker-compose.yml luôn là `brain` và không nhận
# GEMINI_API_KEY (core là cửa trước công khai). Muốn engine Go thì ghép rõ
#   docker compose -f docker-compose.yml -f docker-compose.nep-go.yml up -d core
# -- file đó bật `go` và đưa khoá cho core. Chưa bật ở đâu cả trước khi eval T1
# xanh trong CI, ADR-0044 được ký và review bảo mật khoá trong core xong.
MOBILE_AI_ENGINE_NEP=
# Cùng cách cho trợ lý nhóm «Rủ Đi AI» trong luồng (lát 9): `brain` (mặc định)
# giữ companion-reply và chat-expense của brain; `go` chạy engine Go cho nhóm
# (cùng engine, cùng khoá, nhận thêm lệnh `hoi`, cần chatassist version 6 và
# ai_turn_metrics version 5 từ `core migrate-chat`). Chưa bật ở đâu cả.
MOBILE_AI_ENGINE_GROUP=
# Reranker của engine Go (ADR-0049 §2.3–2.4): qwen/qwen3-reranker-8b trên
# OpenRouter (chỉ Fireworks), gọi qua sidecar OpenRouter ở loopback, POST
# {URL}/rerank. TRỐNG = không rerank: truy hồi giữ thứ tự RRF và gắn cờ
# no_rerank. http chỉ tới loopback; ra ngoài máy phải là https. Hỏng/quá hạn
# thì giữ thứ tự RRF, không thử lại trong lượt, mạch ngắt sau 5 lỗi/30 s; điểm
# chỉ để xếp, không bao giờ làm ngưỡng.
MOBILE_RERANK_URL=
# Tên model gửi trong request; trống = qwen/qwen3-reranker-8b.
MOBILE_RERANK_MODEL=
# Hạn mỗi lời gọi, duration Go trong (0, 60s]; trống = 3s.
MOBILE_RERANK_TIMEOUT=
# Bearer token của endpoint (token nội bộ của sidecar), tuỳ chọn, ≥ 16 ký tự. Không bao giờ ghi log.
MOBILE_RERANK_TOKEN=

# --- Hàng đợi job AI (lát 10, ADR-0045 đề xuất) -------------------------------
# Postgres vẫn là nguồn sự thật: mỗi lần job vào hàng, trigger ghi một dòng
# job_outbox trong cùng transaction; RabbitMQ chỉ làm job bắt đầu sớm hơn.
#
# Broker cho `core work`. TRỐNG = chỉ poll Postgres (250 ms), không mất job nào;
# `core serve` không đọc biến này (worker trong serve luôn chỉ poll). Có giá trị
# thì mỗi process `core work` chạy một relay (publisher confirm) và một consumer
# cho mỗi hàng; poller vẫn chạy mỗi 2 s làm lưới dự phòng. amqp:// hoặc amqps://.
MOBILE_AMQP_URL=
# Các hàng process `core work` nhận việc, cả trên broker lẫn khi poll:
# `ai.group`, `ai.nep`, phân cách bằng dấu phẩy, không dấu cách. Trống = cả hai.
MOBILE_WORKER_QUEUES=
# Pool DB riêng của `core work`: tối đa 50, tối thiểu bằng số kết nối worker
# dùng cùng lúc = MOBILE_AI_WORKERS + 4 tác vụ định kỳ + 1 lượt xả của relay khi
# có broker (mặc định 2 + 4 + 1 = 7); đặt thấp hơn thì process từ chối khởi
# động và nói con số. Trống = max(10, mức sàn). Ngoài pool này: 2 kết nối cho
# heartbeat và bộ đếm lời gọi model, 1 kết nối LISTEN của relay. Tổng serve 15
# + các worker + api phải dưới 100 kết nối của Postgres.
MOBILE_WORKER_DB_CONNS=
# Giới hạn lời gọi model mỗi phút cho MỌI worker cộng lại, theo từng model
# (GCRA trong Redis, khoá rudi:{namespace}:rl:model:{model}). Trống = không giới
# hạn. Đặt số mà không có MOBILE_REDIS_URL thì process từ chối khởi động. Redis
# chết thì lời gọi vẫn đi (fail-open). Chỉ tác dụng với engine Go
# (MOBILE_AI_ENGINE_NEP=go). Giá trị thật chờ hạn mức của khoá Gemini từ Lead.
MOBILE_MODEL_RPM=
# Cũng là nơi giữ stream câu trả lời AI (lát 11: worker ghi, route SSE
# `…/ai-invocations/{id}/events` đọc). Trống = không stream: route /events trả
# 503 `stream_unavailable` và client poll như cũ; Postgres vẫn là nguồn sự thật.
MOBILE_REDIS_URL=
# Tiền tố khoá Redis cho deployment này; trống = `main`.
MOBILE_REDIS_NAMESPACE=

# ─── Máy vnlocal (vnlocal HANDOFF-KET-NOI.md) ───────────────────────────────
# Stack `deploy/vnlocal/compose.yml` KHÔNG đọc file này: nó nạp
# ~/.config/rudi/vnlocal.env (MOBILE_DATABASE_URL, VNLOCAL_PG_DSN,
# VNLOCAL_S3_*) và ~/.config/rudi/stack.env, cả hai mode 600, ngoài repo.
# Mọi dịch vụ bên đó bắt buộc xác thực từ 2026-09-28: MinIO gọi ẩn danh 403,
# agy-proxy khoá ngoài allowlist 401. IP không ghi vào repo: dùng <VNLOCAL_HOST>.
# Kiểm cả bộ: `go run ./cmd/vnlocal-thu ket-noi` trong services/core.
VNLOCAL_PG_DSN=
VNLOCAL_S3_ENDPOINT=
VNLOCAL_S3_FRAMES_BUCKET=
VNLOCAL_S3_ACCESS_KEY=
VNLOCAL_S3_SECRET=
# agy-proxy: cổng nói giao thức OpenAI + Gemini trước pool seat Gemini dùng
# chung (`internal/agyproxy`). URL dạng http://<VNLOCAL_HOST>:20131, không path.
# ĐẶT AGY_PROXY_URL thì engine Go (aiharness/llm) sinh chữ qua agy thay vì
# GEMINI_API_KEY (ADR-0049 §2.1); embedding vẫn đi thẳng Gemini bằng
# GEMINI_API_KEY (agy không phục vụ embedding), kể cả Batch API của
# `core rag v-embed-batch place`.
# Khoá chỉ nằm ở backend, không bao giờ vào app mobile.
AGY_PROXY_URL=
AGY_PROXY_KEY=
